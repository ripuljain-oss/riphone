---
import '../styles/tokens.css';
import '../styles/components.css';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../site';
import { absoluteUrl } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  feed?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

const {
  title,
  description = SITE.description,
  feed = true,
  ogType = 'website',
  ogImage = '/og.png',
  publishedTime,
  tags,
  jsonLd,
  robots = 'index, follow',
} = Astro.props;

const pageTitle =
  title === SITE.name
    ? `${SITE.name} — by ${SITE.author}`
    : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = absoluteUrl(ogImage);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.description}`} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && (
      <meta property="article:author" content={SITE.xUrl} />
    )}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {tags && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:creator" content={SITE.xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${SITE.description}`} />

    {feed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={SITE.name}
        href="/feed.xml"
      />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site guide" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
