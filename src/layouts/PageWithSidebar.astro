---
import Base from './Base.astro';
import Mast from '../components/Mast.astro';

interface Props {
  title: string;
  description?: string;
  current?: '/' | '/archive' | '/feed.xml';
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  current,
  ogType,
  ogImage,
  publishedTime,
  jsonLd,
} = Astro.props;
---

<Base
  title={title}
  description={description}
  ogType={ogType}
  ogImage={ogImage}
  publishedTime={publishedTime}
  jsonLd={jsonLd}
>
  <main id="main" class="page">
    <Mast current={current} />
    <div class="grid">
      <slot name="sidebar" />
      <section class="content">
        <slot />
      </section>
    </div>
  </main>
</Base>
