---
import PageWithSidebar from '../../../../layouts/PageWithSidebar.astro';
import Post from '../../../../components/Post.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import { getAllPosts, postPath, postSlug } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((entry) => {
    const d = entry.data.date;
    return {
      params: {
        year: String(d.getUTCFullYear()),
        month: String(d.getUTCMonth() + 1).padStart(2, '0'),
        day: String(d.getUTCDate()).padStart(2, '0'),
        slug: postSlug(entry),
      },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
---

<PageWithSidebar title={entry.data.title} current="/">
  <aside slot="sidebar" class="sidebar" aria-label="Post">
    <p class="sidebar__h">Back</p>
    <ul>
      <li><a href="/">/latest</a></li>
      <li><a href="/archive">/archive</a></li>
    </ul>
  </aside>

  <article>
    <Post entry={entry} />
    <SiteFooter route={postPath(entry)} />
  </article>
</PageWithSidebar>
