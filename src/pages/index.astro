---
import PageWithSidebar from '../layouts/PageWithSidebar.astro';
import Post from '../components/Post.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../site';
import { getAllPosts, postPath, tagCounts } from '../lib/posts';
import { webSiteJsonLd } from '../lib/seo';

const posts = await getAllPosts();
const feedPosts = posts.slice(0, 10);
const recent = posts.slice(0, 5);
const topTags = tagCounts(posts).slice(0, 4);
---

<PageWithSidebar
  title={SITE.name}
  description={SITE.description}
  jsonLd={webSiteJsonLd()}
  current="/"
>
  <aside slot="sidebar" class="sidebar" aria-label="Site index">
    <p class="sidebar__h">Recent</p>
    <ul>
      {recent.map((entry) => (
        <li><a href={postPath(entry)}>{entry.data.title}</a></li>
      ))}
    </ul>
    <p class="sidebar__h">Tags</p>
    <ul>
      {topTags.map(({ tag, count }) => (
        <li><a href={`/tags/${tag}`}>{tag} ({count})</a></li>
      ))}
    </ul>
    <p class="sidebar__h">More</p>
    <ul>
      <li><a href="/gear">Gear</a></li>
    </ul>
  </aside>

  <section aria-label="Latest posts">
    {feedPosts.map((entry) => <Post entry={entry} />)}
    <SiteFooter version="v1" />
  </section>
</PageWithSidebar>
