{
  "$schema": "https://json.schemastore.org/style-dictionary.json",
  "_about": "ripblog design tokens — chosen direction: Mono Ink + Terracotta. Pair with handoff/tokens.css.",
  "color": {
    "bg":          { "value": "#fafafa", "comment": "warm off-white page background" },
    "fg":          { "value": "#14151a", "comment": "ink — body text, titles, strong rules" },
    "fgMuted":     { "value": "#4a4f57", "comment": "secondary text, blockquote body" },
    "meta":        { "value": "#6b6f78", "comment": "dateline, sidebar, footer copy" },
    "rule":        { "value": "rgba(20,21,26,0.12)", "comment": "hairline dividers between posts/rows" },
    "ruleStrong":  { "value": "#14151a", "comment": "2px masthead underline" },
    "accent":      { "value": "#d97757", "comment": "terracotta — links, stars, wordmark dot, blockquote rule, CTA backgrounds" },
    "accentFg":    { "value": "#ffffff", "comment": "foreground on solid-accent surfaces" }
  },
  "font": {
    "serif": {
      "value": "'Newsreader', 'Source Serif Pro', Georgia, serif",
      "comment": "Body copy + long-form. Variable-width opsz axis 6..72."
    },
    "mono": {
      "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "comment": "Wordmark, nav, post titles, sidebar, datelines — all UI chrome."
    }
  },
  "fontSize": {
    "body":     { "value": "17px", "lineHeight": 1.6 },
    "wordmark": { "value": "20px", "lineHeight": 1.0 },
    "nav":      { "value": "12px" },
    "title":    { "value": "18px", "lineHeight": 1.3 },
    "h1":       { "value": "22px", "lineHeight": 1.35 },
    "dateline": { "value": "11px" },
    "sidebar":  { "value": "12px" },
    "monoSm":   { "value": "11px" },
    "cta":      { "value": "13px" }
  },
  "fontWeight": {
    "regular": { "value": 400 },
    "medium":  { "value": 500 },
    "semi":    { "value": 600 }
  },
  "space": {
    "1":  { "value": "4px"  },
    "2":  { "value": "8px"  },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" },
    "10": { "value": "40px" },
    "11": { "value": "44px" },
    "12": { "value": "48px" },
    "14": { "value": "56px" },
    "20": { "value": "80px" }
  },
  "layout": {
    "pageMax":      { "value": "920px" },
    "contentMax":   { "value": "580px" },
    "sidebarWidth": { "value": "200px" },
    "gridGap":      { "value": "56px"  },
    "pagePadY":     { "value": "48px"  },
    "pagePadX":     { "value": "56px"  },
    "pagePadBottom":{ "value": "80px"  }
  },
  "motion": {
    "fast": { "value": "120ms", "easing": "cubic-bezier(0.2, 0.7, 0.3, 1)" },
    "base": { "value": "180ms", "easing": "cubic-bezier(0.2, 0.7, 0.3, 1)" }
  }
}
